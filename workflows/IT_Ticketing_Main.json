      "id": "n01-trigger",
      "name": "Outlook Trigger - New Mail",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [0, 400],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "7uyBvNQLSjMWB4rC",
