        "name": "Get Inbox Messages",
        "type": "n8n-nodes-base.microsoftOutlook",
        "typeVersion": 2,
        "position": [
          -1728,
          480
        ],
        "webhookId": "fd219de0-3c26-412f-a0ef-8306330aaca6",
        "credentials": {
          "microsoftOutlookOAuth2Api": {
            "id": "7uyBvNQLSjMWB4rC",
            "name": "IT Support Microsoft Outlook"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// ============================================================\n// Extract, Filter, De-loop & Prioritize incoming support emails\n// ============================================================\nconst ONE_HOUR_MS = 60 * 60 * 1000;\nconst now = Date.now();\n\n// Identifiers that mean \"this email came from us, or is an automated\n// system message\" -- must be dropped to prevent infinite loops.\nconst SELF_SENDER_MATCHES = [\n  \"itsupport@nextgeninnov8.com\",\n  \"itsupport_nextgeninnov8_com\"\n];\n\nconst AUTO_REPLY_SUBJECT_PREFIXES = [\n  \"automatic reply:\",\n  \"auto:\",\n  \"out of office\",\n  \"undeliverable:\",\n  \"read:\",\n  \"delivery status notification\",\n  \"mail delivery failed\"\n];\n\nconst HIGH_PRIORITY_KEYWORDS = [\n  \"urgent\", \"asap\", \"critical\", \"down\", \"outage\", \"emergency\",\n  \"not working\", \"cannot work\", \"can't work\", \"blocked\",\n  \"security breach\", \"breach\", \"data loss\", \"production down\",\n  \"server down\", \"all hands\", \"cannot access\", \"can't access\"\n];\n\nconst LOW_PRIORITY_KEYWORDS = [\n  \"whenever\", \"no rush\", \"minor\", \"question\", \"inquiry\",\n  \"when you get a chance\", \"low priority\", \"just curious\", \"fyi\"\n];\n\nfunction detectPriority(subject, body) {\n  const text = `${subject} ${body}`.toLowerCase();\n  if (HIGH_PRIORITY_KEYWORDS.some((k) => text.includes(k))) return \"High\";\n  if (LOW_PRIORITY_KEYWORDS.some((k) => text.includes(k))) return \"Low\";\n  return \"Medium\";\n}\n\nfunction isSelfSent(senderEmail) {\n  const lower = (senderEmail || \"\").toLowerCase();\n  return SELF_SENDER_MATCHES.some((s) => lower.includes(s.toLowerCase()));\n}\n\nfunction isAutoReply(subject) {\n  const lower = (subject || \"\").trim().toLowerCase();\n  return AUTO_REPLY_SUBJECT_PREFIXES.some((prefix) => lower.startsWith(prefix));\n}\n\nconst results = [];\n\nfor (const inputItem of $input.all()) {\n  const item = inputItem.json;\n\n  // --- 1. Time window filter ---\n  const rawDate = item.receivedDateTime || item.createdDateTime || item.sentDateTime;\n  if (!rawDate) continue;\n  const emailTime = new Date(rawDate).getTime();\n  if (isNaN(emailTime)) continue;\n  const ageInMs = now - emailTime;\n  if (ageInMs < 0 || ageInMs > ONE_HOUR_MS) continue;\n\n  // --- 2. Extract sender info ---\n  const fromObj = item.from || item.sender || {};\n  const emailAddrObj = fromObj.emailAddress || fromObj;\n\n  let senderEmail = \"\";\n  if (typeof emailAddrObj === \"string\") {\n    senderEmail = emailAddrObj;\n  } else {\n    senderEmail = emailAddrObj.address || emailAddrObj.email || fromObj.address || \"\";\n  }\n\n  // --- 3. Anti-loop guards (FR-2) ---\n  if (isSelfSent(senderEmail)) continue;\n  if (isAutoReply(item.subject)) continue;\n\n  let senderName = \"\";\n  if (typeof emailAddrObj === \"object\") {\n    senderName = emailAddrObj.name || fromObj.name || \"\";\n  }\n  if (!senderName || senderName.trim() === \"\" || senderName === senderEmail) {\n    if (senderEmail && senderEmail.includes(\"@\")) {\n      const namePart = senderEmail.split(\"@\")[0];\n      senderName = namePart\n        .replace(/[._-]/g, \" \")\n        .replace(/\\b\\w/g, (char) => char.toUpperCase());\n    } else {\n      senderName = \"Valued User\";\n    }\n  }\n\n  // --- 4. Sanitize body (FR-5) ---\n  let rawBody = item.bodyPreview || item.body?.content || \"\";\n  let cleanedBody = rawBody\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, \"\")\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, \"\")\n    .replace(/<[^>]*>/g, \"\")\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\r/g, \"\\n\")\n    .split(\"\\n\")\n    .map((line) => line.trim())\n    .filter((line) => line.length > 0)\n    .join(\"\\n\\n\");\n\n  if (cleanedBody.length > 1500) {\n    cleanedBody = cleanedBody.substring(0, 1497) + \"...\";\n  }\n\n  // --- 5. Priority detection ---\n  const priority = detectPriority(item.subject || \"\", cleanedBody);\n\n  results.push({\n    json: {\n      messageId: item.id,\n      conversationId: item.conversationId,\n      internetMessageId: item.internetMessageId,\n      subject: item.subject || \"(no subject)\",\n      senderName,\n      senderEmail,\n      bodyPreview: cleanedBody || \"(no content)\",\n      receivedDateTime: item.receivedDateTime || item.createdDateTime,\n      priority\n    }\n  });\n}\n\nreturn results;\n"
        },
        "id": "d4f2497c-04d2-4a9b-966f-d098d366bac2",
        "name": "Extract, Filter & Prioritize",
