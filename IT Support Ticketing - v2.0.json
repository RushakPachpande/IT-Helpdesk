      {
        "parameters": {
          "jsCode": "const item = $input.item.json;\n\nconst now = new Date();\nconst yyyy = now.getFullYear();\nconst mm = String(now.getMonth() + 1).padStart(2, \"0\");\nconst dd = String(now.getDate()).padStart(2, \"0\");\nconst hh = String(now.getHours()).padStart(2, \"0\");\nconst min = String(now.getMinutes()).padStart(2, \"0\");\nconst ss = String(now.getSeconds()).padStart(2, \"0\");\n\n// 4-character random suffix guards against same-second collisions\n// (belt-and-suspenders on top of the sequential single-item loop).\nconst randomSuffix = Math.random().toString(36).substring(2, 6).toUpperCase();\n\nconst ticketId = `NGI-${yyyy}${mm}${dd}-${hh}${min}${ss}-${randomSuffix}`;\n\nreturn {\n  json: {\n    ...item,\n    ticketId\n  }\n};\n"
        },
