      {
        "parameters": {
          "operation": "reply",
          "messageId": {
            "__rl": true,
            "value": "={{ $json.messageId }}",
            "mode": "id"
          },
          "message": "=<div style=\"font-family: 'Segoe UI', Helvetica, Arial, sans-serif; background-color: #f4f6f9; padding: 20px; color: #333333;\">\n  <div style=\"max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);\">\n\n    <div style=\"background-color: #0056b3; padding: 20px 25px; color: #ffffff;\">\n      <h2 style=\"margin: 0; font-size: 20px; font-weight: 600;\">IT Support Request Received</h2>\n    </div>\n\n    <div style=\"padding: 25px;\">\n      <p style=\"font-size: 15px; line-height: 1.5; margin-top: 0;\">Dear <strong>{{ $json.senderName }}</strong>,</p>\n      <p style=\"font-size: 14px; color: #555555; line-height: 1.5;\">Thank you for reaching out. We have logged a new support ticket for your request.</p>\n\n      <div style=\"background-color: #f8fafc; border-left: 4px solid #0056b3; padding: 15px 20px; margin: 20px 0; border-radius: 0 6px 6px 0;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n          <tr>\n            <td style=\"padding: 4px 0; color: #64748b; width: 110px;\"><strong>Ticket ID:</strong></td>\n            <td style=\"padding: 4px 0; font-weight: 700; color: #0056b3;\">{{ $json.ticketId }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 4px 0; color: #64748b;\"><strong>Subject:</strong></td>\n            <td style=\"padding: 4px 0; color: #1e293b;\">{{ $json.subject }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 4px 0; color: #64748b;\"><strong>Status:</strong></td>\n            <td style=\"padding: 4px 0;\"><span style=\"background-color: #dbeafe; color: #1e40af; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 600;\">NEW</span></td>\n          </tr>\n          <tr>\n            <td style=\"padding: 4px 0; color: #64748b;\"><strong>Priority:</strong></td>\n            <td style=\"padding: 4px 0; color: #1e293b;\">{{ $json.priority }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 4px 0; color: #64748b;\"><strong>Received:</strong></td>\n            <td style=\"padding: 4px 0; color: #1e293b;\">{{ $now.toFormat('dd-MM-yyyy hh:mm a') }}</td>\n          </tr>\n        </table>\n      </div>\n\n      <p style=\"font-size: 14px; color: #555555; line-height: 1.5;\">Our support team is reviewing your request and will follow up with you shortly on this thread.</p>\n\n      <hr style=\"border: none; border-top: 1px solid #e2e8f0; margin: 25px 0 15px 0;\" />\n      <p style=\"font-size: 13px; color: #64748b; margin: 0; line-height: 1.4;\">\n        Best regards,<br>\n        <strong style=\"color: #1e293b;\">Rushak Pachpande</strong><br>\n        NGI IT Support Team\n      </p>\n    </div>\n  </div>\n</div>",
          "options": {}
        },
        "id": "a0e42e05-54b5-4942-a703-7f0ef892a71a",
