      {
        "parameters": {
          "jsCode": "const activeBatch = $('Loop Through Emails').first();\nconst ticketData = $('Generate Ticket ID').first();\n\nconst splitJson = activeBatch ? activeBatch.json : {};\nconst ticketJson = ticketData ? ticketData.json : {};\n\nconst messageId = splitJson.messageId || ticketJson.messageId;\n\nif (!messageId || typeof messageId !== \"string\" || messageId.trim() === \"\") {\n  throw new Error(`Missing valid Outlook messageId for reply. Received: ${JSON.stringify(messageId)}`);\n}\n\nreturn [{\n  json: {\n    messageId: messageId.trim(),\n    conversationId: ticketJson.conversationId || splitJson.conversationId,\n    ticketId: ticketJson.ticketId || \"NGI-TICKET\",\n    senderName: ticketJson.senderName || splitJson.senderName || \"Valued User\",\n    senderEmail: ticketJson.senderEmail || splitJson.senderEmail || \"\",\n    subject: ticketJson.subject || splitJson.subject || \"(no subject)\",\n    priority: ticketJson.priority || splitJson.priority || \"Medium\"\n  }\n}];\n"
        },
