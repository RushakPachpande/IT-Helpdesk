# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_PORT=8080
# URL employees open on the LAN (used in email links)
APP_PUBLIC_URL=http://192.168.1.10:8080
# OAuth redirects must use localhost (Microsoft/Google reject plain-http LAN addresses)
OAUTH_REDIRECT_BASE=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata
# Set to true only if the app is served over HTTPS
COOKIE_SECURE=false
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
SESSION_TTL_HOURS=12

# --- Database ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
# Used by the app and Prisma CLI. Inside Docker Compose the host is "db".
DATABASE_URL=postgresql://helpdesk:change-me@localhost:5433/helpdesk?schema=public

# --- First admin (created by the seed if no admin exists) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=IT Admin
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ALLOWED_DOMAIN=example.com

# --- Microsoft 365 mailbox (Entra app registration, Web platform) ---
# Redirect URI to register: http://localhost:8080/api/mailbox/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Directory (tenant) ID, or "organizations"
MS_TENANT_ID=organizations

# --- Google / Gmail mailbox (OAuth client type "Web application") ---
# Redirect URI to register: http://localhost:8080/api/mailbox/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Backups (Docker "backup" service, daily) ---
BACKUP_KEEP_DAYS=14
